DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Stripe — test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Only needed when running scripts/reset-admin.ts
ADMIN_RESET_PASSWORD=
