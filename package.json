{
  "name": "delicious-planet",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --no-server-fast-refresh --webpack",
    "devsafe": "npx rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "products:disable-imageless": "cross-env NODE_OPTIONS=--no-deprecation tsx md/scripts/disable-imageless-products.ts",
    "import:admiral": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/import-admiral-caviar.ts",
    "import:casinetto": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/import-casinetto.ts",
    "import:caputo": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/import-caputo.ts",
    "import:intermex": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/import-intermex.ts",
    "import:velsoro": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/import-velsoro.ts",
    "scrape:admiral": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/scrape-admiral-caviar.ts",
    "import:gdlc": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/import-garcia-de-la-cruz.ts",
    "seed:banners": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/seed-banners.ts",
    "seed:collection-images": "cross-env NODE_OPTIONS=--no-deprecation tsx md/seed/upload-collection-images.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "db:push": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/db-push.mjs",
    "migrate:apply": "node scripts/apply-migration.cjs",
    "media:recover": "cross-env NODE_OPTIONS=--no-deprecation tsx md/scripts/recover-media.ts",
    "media:cleanup": "cross-env NODE_OPTIONS=--no-deprecation tsx md/scripts/cleanup-r2.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.80.0",
    "@payloadcms/next": "3.80.0",
    "@payloadcms/richtext-lexical": "3.80.0",
    "@payloadcms/storage-s3": "3.80.0",
    "@payloadcms/ui": "3.80.0",
    "@tailwindcss/postcss": "^4.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "^12.38.0",
    "graphql": "^16.8.1",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "payload": "3.80.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.2",
    "stripe": "^21.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.1",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
