# ─── Database ────────────────────────────────────────────────────────────────
# Postgres. The project uses @payloadcms/db-postgres — a mongodb:// URL will not
# work. Schema changes are applied with `pnpm migrate`, never by auto-push.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/delicious_planet

# Signs auth cookies and reset tokens. Any long random string; changing it logs
# every admin user out.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ─── Media storage: Cloudflare R2 ────────────────────────────────────────────
# All four are required. The S3 adapter is enabled unconditionally in
# payload.config.ts, so uploads fail without them.
#
# Cloudflare dashboard → R2 → your bucket:
#   R2_BUCKET      the bucket name
#   R2_ENDPOINT    "https://<account-id>.r2.cloudflarestorage.com" — account
#                  scoped, with NO bucket in the path. The bucket's Settings
#                  page shows it with the bucket name appended; strip that, or
#                  the adapter (which appends the bucket itself) writes to
#                  /<bucket>/<bucket>/… and every upload 404s.
#   R2_ACCESS_*    Manage R2 API Tokens → Create token, "Object Read & Write"
R2_BUCKET=delicious-planet-media
R2_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx

# The public domain the bucket is served on — what browsers actually fetch, and
# a different host from R2_ENDPOINT (that one is private, credentialed).
# Either the free r2.dev subdomain (bucket → Settings → Public Development URL)
# or a custom domain. Must be set at BUILD time as well as runtime: next.config.ts
# derives its next/image `remotePatterns` entry from it, and next/image rejects
# any host missing from that list. No trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY the checkout route returns 503 and retail orders
# cannot be placed; B2B orders are unaffected (they are invoiced, not charged).
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Optional ────────────────────────────────────────────────────────────────
# Escape hatch only. Set to "true" for a one-off `pnpm db:push` when reconciling
# a database that was previously managed by push — see the comment in
# payload.config.ts. Leave unset for normal development and for production.
# PAYLOAD_DB_PUSH=

# Only needed when running md/scripts/reset-admin.ts
ADMIN_RESET_PASSWORD=

# ─── Public site URL ─────────────────────────────────────────────────────────
# The canonical origin the site is served on, with no trailing slash. Used for
# metadataBase (which turns relative og:image paths into absolute URLs),
# /sitemap.xml and /robots.txt.
#
# Set this in production. Without it the app falls back to
# VERCEL_PROJECT_PRODUCTION_URL and then to http://localhost:3000 — either of
# which puts the wrong host in every canonical tag and sitemap entry.
NEXT_PUBLIC_SITE_URL=https://deliciousplanet.co

# ─── Transactional email: SMTP ───────────────────────────────────────────────
# Required in production — payload.config.ts throws without SMTP_HOST/USER/
# PASSWORD, because a deploy that silently sends nothing is worse than one that
# refuses to boot: password resets return "check your email" while delivering
# nothing, and every order confirmation is dropped.
#
# Locally these are optional. With them unset no adapter is registered and
# Payload falls back to its console stub, which logs the fully rendered message
# instead of sending it — enough to develop and review every template without
# an account or a single DNS record.
#
# This domain's mail is on Google Workspace (MX is smtp.google.com), so sending
# through the same account means outbound mail is DKIM-signed by the provider
# that already owns the domain.
SMTP_HOST=smtp.gmail.com

# 465 is implicit TLS and the default. Use 587 only if the host blocks 465 —
# the config switches to STARTTLS automatically for it.
SMTP_PORT=465

# The full mailbox address that authenticates. orders@ is a real Workspace
# user; business@ (the public contact address) is only an alias, so it cannot
# sign in here.
SMTP_USER=orders@deliciousplanet.co

# A Google APP PASSWORD — NOT the account password. Google removed plain
# password SMTP in 2022, so this only works on an account with 2-Step
# Verification enabled:
#   myaccount.google.com → Security → 2-Step Verification → App passwords
# Generate one, and paste the 16 characters here with the spaces removed.
SMTP_PASSWORD=

# Who the mail appears to come from. Defaults to SMTP_USER when unset, which is
# the safe choice: Gmail rewrites a From address the authenticated account does
# not own, so setting this to something else silently sends under the wrong
# address unless that address is first added in Gmail as a verified
# "Send mail as" alias.
EMAIL_FROM=orders@deliciousplanet.co
EMAIL_FROM_NAME=Delicious Planet

# The sender of the customer's order confirmation only, so replies about an
# order land in the order mailbox. Every other email uses EMAIL_FROM. It must
# be a verified "Send mail as" address on the SMTP_USER account (Gmail →
# Settings → Accounts → Send mail as), or Gmail silently sends it from
# SMTP_USER instead. Unset, confirmations go out from EMAIL_FROM — already
# orders@ here, so this is left empty.
ORDER_EMAIL_FROM=

# Fallback for staff notifications (new orders, new enquiries). The address in
# Site Settings → Notifications wins when set, so this is only the backstop for
# a fresh environment where nobody has filled that field in yet; failing that,
# the published company mailbox in src/lib/contact.ts is used.
ADMIN_NOTIFICATION_EMAIL=
